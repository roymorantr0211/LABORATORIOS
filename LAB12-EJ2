#include <iostream>
#include <string>
using namespace std;

void pedirCantidad(int &n);
bool validarPregunta(string p);
void registrar(string preguntas[], int n);
void mostrar(string preguntas[], int n);

int main() {
    string preguntas[100];
    int n;

    pedirCantidad(n);
    registrar(preguntas, n);
    mostrar(preguntas, n);

    return 0;
}

void pedirCantidad(int &n) {
    do {
        cout << "Ingrese la cantidad de preguntas: ";
        cin >> n;
        if (n < 1 || n > 100) {
            cout << "Cantidad invalida." << endl;
        }
    } while (n < 1 || n > 100);
    cin.ignore();
}

bool validarPregunta(string p) {
    if (p.length() == 0) {
        return false;
    }
    if (p.at(0) == ' ' || p.at(p.length() - 1) == ' ') {
        return false;
    }
    return true;
}

void registrar(string preguntas[], int n) {
    for (int i = 0; i < n; i++) {
        do {
            cout << "Pregunta " << i + 1 << ": ";
            getline(cin, preguntas[i]);

            if (!validarPregunta(preguntas[i])) {
                cout << "Error: no deje la pregunta vacia ni ponga espacios al inicio o final." << endl;
            }
        } while (!validarPregunta(preguntas[i]));
    }
}

void mostrar(string preguntas[], int n) {
    cout << "\n===== PREGUNTAS REGISTRADAS =====" << endl;
    for (int i = 0; i < n; i++) {
        cout << i + 1 << ". " << preguntas[i] << endl;
    }
}
