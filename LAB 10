#include <iostream>
using namespace std;

int main() {
    int notas[100];
    int n, mayor, menor;
    float suma = 0, promedio;

    do {
        cout << "Ingrese la cantidad de estudiantes: ";
        cin >> n;
        if (n < 1 || n > 100) {
            cout << "Cantidad invalida. Debe ser entre 1 y 100." << endl;
        }
    } while (n < 1 || n > 100);

    for (int i = 0; i < n; i++) {
        do {
            cout << "Nota estudiante " << i + 1 << ": ";
            cin >> notas[i];
            if (notas[i] < 0 || notas[i] > 100) {
                cout << "Nota invalida. Ingrese entre 0 y 100." << endl;
            }
        } while (notas[i] < 0 || notas[i] > 100);
    }

    mayor = notas[0];
    menor = notas[0];

    cout << "\nNOTAS REGISTRADAS" << endl;
    for (int i = 0; i < n; i++) {
        cout << notas[i] << "  ";
        suma = suma + notas[i];

        if (notas[i] > mayor) {
            mayor = notas[i];
        }
        if (notas[i] < menor) {
            menor = notas[i];
        }
    }

    promedio = suma / n;

    cout << "\nPromedio general: " << promedio << endl;
    cout << "Nota mayor: " << mayor << endl;
    cout << "Nota menor: " << menor << endl;

    return 0;
}
