#include <iostream>
#include <string>
using namespace std;

// Prototipos
void registrar(string &nombre, string &apellido);
string unirNombre(string nombre, string apellido);
int contarCaracteres(string nombre, string apellido);
void mostrar(string completo, int cantidad);

int main() {
    string nombre, apellido, completo;
    int cantidad;

    registrar(nombre, apellido);

    completo = unirNombre(nombre, apellido);
    cantidad = contarCaracteres(nombre, apellido);

    mostrar(completo, cantidad);

    return 0;
}

// Funciones
void registrar(string &nombre, string &apellido) {
    cout << "Ingrese el nombre: ";
    getline(cin, nombre);

    cout << "Ingrese el apellido: ";
    getline(cin, apellido);
}

string unirNombre(string nombre, string apellido) {
    return nombre + " " + apellido;
}

int contarCaracteres(string nombre, string apellido) {
    return nombre.length() + apellido.length();
}

void mostrar(string completo, int cantidad) {
    cout << "\nNombre completo: " << completo << endl;
    cout << "Cantidad de letras: " << cantidad << endl;
}
